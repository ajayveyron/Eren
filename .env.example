# Provider: google-vertex | anthropic | openai
EREN_PROVIDER=google-vertex
EREN_MODEL=gemini-2.5-flash

# Google Vertex AI (when EREN_PROVIDER=google-vertex)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vertex-ai-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Anthropic (when EREN_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (when EREN_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Web search (optional, enables web_search tool)
# WEB_SEARCH_API_KEY=your-serper-api-key

DATABASE_URL=postgres://postgres:postgres@localhost:5432/eren
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=eren-run-queue
EREN_DEFAULT_RUN_ID=run-eren-001
